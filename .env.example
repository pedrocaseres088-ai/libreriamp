# ===== Variables para Railway (Service > Variables) =====

# Base de datos: en Railway usá referencias al servicio MySQL, ej: DB_HOST=${{MySQL.MYSQLHOST}}
# (env.php también lee MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE automáticamente)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kiosco_online
DB_USER=root
DB_PASS=

# Mercado Pago (Credenciales de PRUEBA para probar / de PRODUCCIÓN para cobrar de verdad)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# URL pública de tu app, sin barra final. Ej: https://tu-app.up.railway.app
BASE_URL=

# Contraseña del panel /admin (usuario: admin)
ADMIN_PASSWORD=

# Emails: en Railway Free/Hobby usá Resend (HTTPS). SMTP solo funciona en plan Pro.
RESEND_API_KEY=
RESEND_FROM=Librería Online <onboarding@resend.dev>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Librería Online

DOWNLOAD_EXPIRY_HOURS=72
DOWNLOAD_MAX=5
